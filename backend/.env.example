PORT=3000

# Google Drive target folder ID (optional — overridden per-client via clients.json)
GOOGLE_DRIVE_FOLDER_ID=

# OAuth2 credentials (primary method)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Service account (fallback — paste full JSON as single line)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
